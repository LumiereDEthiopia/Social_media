# Port the Express server listens on (0.0.0.0).
# Railway sets this automatically — do not hard-code it.
PORT=3000

# Where the SQLite database file lives.
# Local:  ./data/database.sqlite
# Railway (with a Volume mounted at /app/data): /app/data/database.sqlite
# The parent directory is created automatically if it does not exist.
DATABASE_PATH=./data/database.sqlite
