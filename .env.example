# Port the Express server listens on (0.0.0.0).
# Vercel sets this automatically — do not hard-code it.
PORT=3000

# ---------------------------------------------------------------------------
# THE DATABASE
# ---------------------------------------------------------------------------
# Leave BOTH of these unset to use a local SQLite file at
# ./data/database.sqlite. Nothing to set up, nothing to sign up for.
#
# On Vercel you MUST set both, because Vercel has no persistent disk: a file
# created inside the app is deleted on the next cold start.
#
# 1. Create a free hosted SQLite database at https://turso.tech
# 2. Run:  turso db create lumiere
# 3. Copy the two values it prints into your Vercel environment variables.
DATABASE_URL=file:./data/database.sqlite
# DATABASE_URL=libsql://your-db-yourname.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOi...
